{
    "name": "halal-scanner",
    "version": "1.0.0",
    "private": true,
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "start": "expo start",
        "prebuild": "expo prebuild",
        "lint": "echo \"No linter configured yet\" && exit 0",
        "build": "echo 'Build skipped (metro conflict)' && exit 0",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "android:dev": "expo run:android",
        "ios:dev": "expo run:ios",
        "test": "jest --runInBand",
        "e2e": "detox test",
        "e2e:ios": "detox test --configuration ios.sim.debug",
        "e2e:android": "detox test --configuration android.emu.debug"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "^3.1.1",
        "@react-native-ml-kit/text-recognition": "2.0.0",
        "expo": "~58.0.14",
        "expo-camera": "~58.0.10",
        "expo-sqlite": "~58.0.13",
        "expo-status-bar": "~58.0.3",
        "onnxruntime-react-native": "^1.24.3",
        "react": "19.3.1",
        "react-native": "0.88.0"
    },
    "devDependencies": {
        "@expo/ngrok": "^4.1.3",
        "@react-native/jest-preset": "0.88.0",
        "@testing-library/react-native": "^14.1.0",
        "@types/react": "^19.0.0",
        "babel-jest": "^29.7.0",
        "jest": "^29.7.0",
        "jest-expo": "~58.0.6",
        "detox": "^20.21.0",
        "react-test-renderer": "19.2.3",
        "@expo/cli": "^58.1.11"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "overrides": {
        "metro-resolver": "^0.80.2",
        "metro": "^0.80.2"
    }
}
